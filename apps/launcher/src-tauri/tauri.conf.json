{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NodeClient",
  "version": "0.1.18",
  "identifier": "app.nodeclient.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NodeClient",
        "width": 1240,
        "height": 820,
        "minWidth": 940,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost blob: data: https://textures.minecraft.net https://cdn.modrinth.com; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; font-src 'self'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/app.nodeclient.launcher/**",
          "$APPDATA/app.nodeclient.launcher/**/*",
          "$APPLOCALDATA/app.nodeclient.launcher/**",
          "$APPLOCALDATA/app.nodeclient.launcher/**/*"
        ]
      },
      "capabilities": [
        {
          "identifier": "main",
          "windows": ["main"],
          "permissions": ["core:default"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
